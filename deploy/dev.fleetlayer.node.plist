<?xml version="1.0" encoding="UTF-8"?>
<!-- fleetlayer-node as a per-user launchd agent. `fleetlayer-node install` fills in the placeholders and writes this to
     ~/Library/LaunchAgents/dev.fleetlayer.node.plist. It must be an agent in the user's GUI session, not a daemon:
     plugins that write to the login keychain need it unlocked. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.fleetlayer.node</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BIN}}</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
