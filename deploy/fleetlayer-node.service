# fleetlayer-node as a systemd user service. `fleetlayer-node install` fills in the placeholders, writes this to
# ~/.config/systemd/user/fleetlayer-node.service and enables it. To keep it running while you're logged out:
# loginctl enable-linger "$USER".
[Unit]
Description=Fleetlayer node
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={{BIN}} run
# The node runs plugins, which run herdr and claude: the PATH they were found on when you installed it.
Environment=PATH={{PATH}}
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
