#!/usr/bin/env bash
# Fleetlayer's Rust builds, tests and lints run on a build server, not on a laptop or a small agents VM: Rust target/
# folders grow to tens of GB. Each command copies the checkout there first (/opt/code/fleetlayer/checkouts/<name>, with
# its own target/), takes a build slot, then runs cargo pinned to CPUs 0-7 under nice, inside a memory scope.
#
#   scripts/on-dev fmt | check [args] | clippy [args] | test [args] | build [args]
#       cargo fmt --check; cargo check; clippy --all-targets -D warnings; cargo test; cargo build.
#   scripts/on-dev format   run cargo fmt there and copy the formatted sources back
#   scripts/on-dev lock     update Cargo.lock there (after changing dependencies) and copy it back
#   plugins/matrix is a workspace of its own: pass --manifest-path plugins/matrix/Cargo.toml to check, clippy, test
#   and build it (fmt, format and lock cover it already).
#   scripts/on-dev sync     only copy the checkout there
#   scripts/on-dev clean    delete this checkout's copy and target/ there
#
# The checkout is the one the current directory is in (the main one or a worktree); its name there is its directory's.
#
# The build hosts come from $FLEETLAYER_DEV_HOST, or from .dev-host at the checkout's root (gitignored): one SSH host
# with Rust (rustup) and rsync per line, optionally followed by its build-slot name and the memory for heavy and light
# commands (`build-a build-a 12G 6G`). With several hosts, each checkout always uses the same one (picked from its
# name), so its target/ stays warm there.
set -euo pipefail
dir=$(git rev-parse --show-toplevel)
name=$(basename "$dir")
hosts=${FLEETLAYER_DEV_HOST:-$(grep -v '^[[:space:]]*\(#\|$\)' "$dir/.dev-host" 2>/dev/null || true)}
[ -n "$hosts" ] || { echo "scripts/on-dev: set FLEETLAYER_DEV_HOST or write the build host to .dev-host" >&2; exit 2; }
count=$(printf '%s\n' "$hosts" | wc -l)
pick=$(( $(printf '%s' "$name" | cksum | cut -d' ' -f1) % count + 1 ))
read -r host slot_name heavy_mem light_mem <<<"$(printf '%s\n' "$hosts" | sed -n "${pick}p")"
export FLEETLAYER_DEV_SLOT_RESOURCE=${slot_name:-}
heavy_mem=${heavy_mem:-12G}
light_mem=${light_mem:-6G}
remote_root=/opt/code/fleetlayer/checkouts
remote=$remote_root/$name

die() { echo "scripts/on-dev: $*" >&2; exit 1; }
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
[ $# -gt 0 ] || usage
cmd=$1; shift

sync() {
  ssh "$host" "mkdir -p '$remote'"
  # By content, with fresh times on what changed: a copied timestamp can be older than the last build, and cargo
  # would then skip recompiling the file.
  rsync -rlpD --checksum --delete-after --filter=':- .gitignore' --exclude=.git "$dir/" "$host:$remote/"
}

# The build-slot helper's path, or nothing. A relative path in .dev-slot is relative to the checkout.
slot_helper() {
  local slot="${FLEETLAYER_DEV_SLOT:-}"
  [ -z "$slot" ] && [ -f "$dir/.dev-slot" ] && slot=$(cat "$dir/.dev-slot")
  [ -z "$slot" ] && slot=$(command -v fleetlayer-dev-slot || true)
  case $slot in "" | /*) ;; none) slot= ;; *) [ -x "$dir/$slot" ] && slot="$dir/$slot" ;; esac
  printf '%s' "$slot"
}

# One remote command, quoted for the remote shell, with the toolchain on PATH and the CPUs pinned.
run() {
  local quoted
  printf -v quoted '%q ' "$@"
  local status slot_id=""
  # A build slot, if this machine has a way to take one (a shared build server): $FLEETLAYER_DEV_SLOT, .dev-slot, or
  # fleetlayer-dev-slot on PATH names an executable called as `<it> acquire <reason>` (prints an ID once a slot is
  # free) and `<it> release <ID>`. scripts/fleetlayer-dev-slot is one, on `fleetlayer lease`; the slot is tied to this
  # script's process, so it's released even if this script is killed.
  local slot
  slot=$(slot_helper)
  # fmt, check and clippy don't link: they take a light slot (more run at once); build and test take a heavy one.
  case "$cmd" in fmt | format | check | clippy) export FLEETLAYER_DEV_SLOT_CLASS=light ;; *) export FLEETLAYER_DEV_SLOT_CLASS=heavy ;; esac
  if [ -n "$slot" ]; then
    # Without a slot it doesn't build: unlimited builds are what the slots prevent. FLEETLAYER_DEV_SLOT=none skips it.
    slot_id=$(FLEETLAYER_LEASE_PID=$$ "$slot" acquire "fleetlayer on-dev $cmd ($(basename "$dir"))") || {
      echo "on-dev: couldn't take a build slot (the helper's error is above), so not building. Run it again once the helper works, or set FLEETLAYER_DEV_SLOT=none to build without a slot on purpose." >&2
      return 75
    }
    [ -n "$slot_id" ] && trap '"$slot" release "$slot_id" >/dev/null 2>&1 || true' RETURN
  fi
  set +e
  # Light commands (fmt, check, clippy) get a smaller memory scope. Both share a compile cache when the host has one:
  # kache first (each checkout keeps its own target/, with dependency outputs restored as copy-on-write clones), else
  # sccache in its own directory and server port, so it never mixes with other projects' builds on the host.
  local mem=$heavy_mem
  [ "${FLEETLAYER_DEV_SLOT_CLASS:-heavy}" = light ] && mem=$light_mem
  local cache="[ -f /opt/code/fleetlayer/kache.toml ] && export KACHE_CONFIG=/opt/code/fleetlayer/kache.toml; if command -v kache >/dev/null; then export RUSTC_WRAPPER=kache; elif command -v sccache >/dev/null; then export RUSTC_WRAPPER=sccache SCCACHE_DIR=/opt/code/fleetlayer/sccache SCCACHE_CACHE_SIZE=20G SCCACHE_SERVER_PORT=4227; fi;"
  ssh "$host" "cd '$remote' && export PATH=\$HOME/.cargo/bin:\$PATH && { $cache true; } && systemd-run --scope -q -p MemoryMax=$mem -p MemorySwapMax=0 nice -n 10 taskset -c 0-7 $quoted" 2>&1 |
    grep --line-buffered -v setlocale
  status=${PIPESTATUS[0]}
  set -e
  return "$status"
}

case $cmd in
  sync) sync ;;
  fmt) sync; run cargo fmt --all --check; run cargo fmt --all --check --manifest-path plugins/matrix/Cargo.toml ;;
  check) sync; run cargo check -q --locked -j 4 --workspace --all-targets "$@" ;;
  clippy) sync; run cargo clippy -q --locked -j 4 --workspace --all-targets "$@" -- -D warnings ;;
  build) sync; run cargo build -q --locked -j 8 "$@" ;;
  test) sync; run cargo test -q --locked -j 8 --workspace "$@" ;;
  format) sync; run cargo fmt --all; run cargo fmt --all --manifest-path plugins/matrix/Cargo.toml; rsync -a --no-owner --no-group --exclude=target --include='*/' --include='*.rs' --exclude='*' "$host:$remote/" "$dir/" ;;
  lock) sync; run cargo update -q "$@"; rsync -a "$host:$remote/Cargo.lock" "$dir/Cargo.lock"
    # The workspaces of their own (plugins/matrix): their lockfiles too.
    for m in plugins/matrix; do
      run cargo update -q --manifest-path "$m/Cargo.toml"; rsync -a "$host:$remote/$m/Cargo.lock" "$dir/$m/Cargo.lock"
    done ;;
  clean) ssh "$host" "rm -rf '$remote'" ;;
  *) die "unknown command $cmd" ;;
esac
