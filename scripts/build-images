#!/usr/bin/env bash
# Builds and pushes a commit's images on the build host, in the background there:
#   <registry>/fleetlayer/control:<sha>   (deploy/Dockerfile)
#   <registry>/fleetlayer/node-bin:<sha>  (the Linux fleetlayer, fleetlayer-node and plugin binaries, and the release's
#                                          skills in /skills: put that folder beside the binaries, FROM scratch)
# Progress: /opt/code/fleetlayer/images/<sha>.log on the build host; <sha>.status there says "done 0" when both are
# pushed (anything else is a failure).
#
#   scripts/build-images [--wait] [<commit>]    defaults to HEAD; the commit must be committed
#
# The build host comes from .dev-host or $FLEETLAYER_DEV_HOST, the registry from .registry or $FLEETLAYER_REGISTRY, and
# the Docker config holding the registry login (on the build host) from .docker-config or $FLEETLAYER_DOCKER_CONFIG
# (default: Docker's own).
set -euo pipefail
dir=$(git rev-parse --show-toplevel)
host=${FLEETLAYER_DEV_HOST:-$(grep -v '^[[:space:]]*\(#\|$\)' "$dir/.dev-host" 2>/dev/null | head -1 || true)}
read -r host slot_name _ <<<"$host"
# Its build-slot name (the second word of its .dev-host line), as on-dev passes it: the helper takes that kind of slot.
export FLEETLAYER_DEV_SLOT_RESOURCE=${FLEETLAYER_DEV_SLOT_RESOURCE:-${slot_name:-}}
registry=${FLEETLAYER_REGISTRY:-$(cat "$dir/.registry" 2>/dev/null || true)}
docker_config=${FLEETLAYER_DOCKER_CONFIG:-$(cat "$dir/.docker-config" 2>/dev/null || true)}
push_env=${docker_config:+DOCKER_CONFIG=$docker_config }
[ -n "$host" ] && [ -n "$registry" ] || { echo "scripts/build-images: set the build host and the registry (see the top of this file)" >&2; exit 2; }
wait=
if [ "${1:-}" = --wait ]; then wait=1; shift; fi
sha=$(git rev-parse --short=7 "${1:-HEAD}")
root=/opt/code/fleetlayer/images
# A build slot, as scripts/on-dev takes (its helper from $FLEETLAYER_DEV_SLOT, .dev-slot or fleetlayer-dev-slot on
# PATH). The build runs in the background on the host, so the slot is tied to a stand-in process that a watcher stops
# once the host writes the status file (or after two hours), which releases it.
slot=${FLEETLAYER_DEV_SLOT:-}
[ -z "$slot" ] && [ -f "$dir/.dev-slot" ] && slot=$(cat "$dir/.dev-slot")
[ -z "$slot" ] && slot=$(command -v fleetlayer-dev-slot || true)
case $slot in "" | /*) ;; none) slot= ;; *) [ -x "$dir/$slot" ] && slot="$dir/$slot" ;; esac
slot_id= anchor=
if [ -n "$slot" ]; then
  sleep 7200 < /dev/null > /dev/null 2>&1 &
  anchor=$!
  slot_id=$(FLEETLAYER_LEASE_PID=$anchor "$slot" acquire "fleetlayer build-images $sha") || {
    echo "build-images: couldn't take a build slot (the helper's error is above), so not building. Run it again once the helper works, or set FLEETLAYER_DEV_SLOT=none to build without a slot on purpose." >&2
    kill "$anchor" 2> /dev/null || true
    exit 75
  }
fi
git archive "$sha" | ssh "$host" "mkdir -p $root/src && cd $root/src && find . -mindepth 1 -maxdepth 1 ! -name target -exec rm -rf {} + && tar -x -m -C ." 2>&1 | grep -v setlocale || true
ssh "$host" "SHA=$sha R=$registry/fleetlayer ROOT=$root PUSH='$push_env' bash -s" > /dev/null 2>&1 <<'REMOTE' &
cd $ROOT/src
rm -f $ROOT/$SHA.status
nohup sh -c "
DOCKER_BUILDKIT=1 docker build -f deploy/Dockerfile -t $R/control:$SHA . > $ROOT/$SHA.log 2>&1 &&
docker run --rm $R/control:$SHA --help > /dev/null 2>&1 &&
$PUSH docker push $R/control:$SHA >> $ROOT/$SHA.log 2>&1 &&
docker run --rm --memory 12g --memory-swap 12g -v $ROOT/src:/src -v fleetlayer-cargo-registry:/usr/local/cargo/registry -w /src rust:1.99.1-bookworm sh -c 'cargo build --release --locked -j 4 -p fleetlayer-cli -p fleetlayer-node -p fleetlayer-herdr -p fleetlayer-rex -p fleetlayer-tmux -p fleetlayer-claude-code -p fleetlayer-summaries -p fleetlayer-file-sync -p fleetlayer-claude-auth-manager -p fleetlayer-accounts -p fleetlayer-pages -p fleetlayer-signin -p fleetlayer-shared-folders -p fleetlayer-scheduler -p fleetlayer-leases -p fleetlayer-presence -p fleetlayer-cookies -p fleetlayer-1password -p fleetlayer-egress -p fleetlayer-herdr-fleet -p fleetlayer-dashboard -p fleetlayer-gateway && cargo build --release --locked -j 4 --manifest-path plugins/matrix/Cargo.toml --target-dir target && rm -rf dist && mkdir dist && cp target/release/fleetlayer-matrix target/release/fleetlayer target/release/fleetlayer-node target/release/fleetlayer-herdr target/release/fleetlayer-rex target/release/fleetlayer-tmux target/release/fleetlayer-claude-code target/release/fleetlayer-summaries target/release/fleetlayer-file-sync target/release/fleetlayer-claude-auth-manager target/release/fleetlayer-claude-accounts target/release/fleetlayer-pages target/release/fleetlayer-signin target/release/fleetlayer-shared-folders target/release/fleetlayer-scheduler target/release/fleetlayer-leases target/release/fleetlayer-presence target/release/fleetlayer-cookies target/release/fleetlayer-1password target/release/fleetlayer-egress target/release/fleetlayer-herdr-fleet target/release/fleetlayer-dashboard target/release/fleetlayer-gateway dist/ && bash scripts/collect-skills dist/skills' >> $ROOT/$SHA.log 2>&1 &&
cd dist && printf 'FROM scratch\nCOPY fleetlayer fleetlayer-matrix fleetlayer-node fleetlayer-herdr fleetlayer-rex fleetlayer-tmux fleetlayer-claude-code fleetlayer-summaries fleetlayer-file-sync fleetlayer-claude-auth-manager fleetlayer-claude-accounts fleetlayer-pages fleetlayer-signin fleetlayer-shared-folders fleetlayer-scheduler fleetlayer-leases fleetlayer-presence fleetlayer-cookies fleetlayer-1password fleetlayer-egress fleetlayer-herdr-fleet fleetlayer-dashboard fleetlayer-gateway /\nCOPY skills /skills\n' > Dockerfile.node-bin &&
DOCKER_BUILDKIT=1 docker build --platform linux/amd64 -f Dockerfile.node-bin -t $R/node-bin:$SHA . >> $ROOT/$SHA.log 2>&1 &&
$PUSH docker push $R/node-bin:$SHA >> $ROOT/$SHA.log 2>&1
echo done \$? > $ROOT/$SHA.status" < /dev/null > /dev/null 2>&1 &
REMOTE
sleep 5
if [ -n "$slot_id" ]; then
  nohup sh -c "i=0; while [ \$i -lt 360 ] && ! ssh '$host' 'test -s $root/$sha.status' > /dev/null 2>&1; do i=\$((i+1)); sleep 20; done; '$slot' release '$slot_id' > /dev/null 2>&1; kill $anchor 2> /dev/null" < /dev/null > /dev/null 2>&1 &
  echo "Holding build slot $slot_id until the build finishes."
fi
echo "Building $sha on $host: $root/$sha.status says done 0 when control and node-bin are pushed."
[ -n "$wait" ] || exit 0
for _ in $(seq 1 90); do
  status=$(ssh "$host" "cat $root/$sha.status 2>/dev/null" 2>/dev/null | grep -v setlocale || true)
  if [ -n "$status" ]; then echo "$status"; [ "$status" = "done 0" ] && exit 0; exit 1; fi
  sleep 20
done
echo "still building after 30 minutes" >&2
exit 1
