// fleetlayer.ai: the built site served as static assets by Cloudflare Workers. Deployed by .github/workflows/site.yml.
{
  "$schema": "https://unpkg.com/wrangler@4.168.0/config-schema.json",
  "name": "fleetlayer-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
